% =====================================================================
%  stylecours.sty - Style commun des documents de cours
%  N. Bancel
%
%  CE QUE C'EST : un fichier de style LaTeX. Pas un programme qu'on lance :
%  un bloc de definitions qu'un document .tex charge au debut. Il n'a AUCUN
%  effet sur les Google Docs (pour eux, voir 00_conventions/google_docs.md
%  et les scripts gdoc_*.py de ~/.claude/scripts/).
%
%  OU SONT LES CONVENTIONS ECRITES : dans 00_conventions/ (voir son README).
%  Ce fichier-ci est l'IMPLEMENTATION du style ; 00_conventions/ en est la
%  documentation. Il vit a la racine, avec mypackages.sty et macros.sty,
%  parce que 156 fichiers .tex du repo chargent deja ces deux-la depuis la
%  racine, a cinq profondeurs de chemin differentes.
%
%  USAGE (depuis un dossier a 2 niveaux, ex. 01_2627_4emes_maths/00_calcul_mental/) :
%
%      \documentclass[11pt]{exam}
%      \usepackage{../../mypackages}
%      \usepackage{../../macros}
%      \usepackage{../../stylecours}
%
%  IMPORTANT : charger mypackages ET macros AVANT stylecours. Ce fichier
%  suppose que tcolorbox, tikz, colortbl, titlesec, multirow et hyperref
%  sont deja disponibles (ils le sont via mypackages).
%
%  CE QU'IL DEFINIT
%    - la palette de couleurs (section "Palette")
%    - 5 encadres : theorie, astuce, attention, aretenir, exemple
%    - 2 environnements d'exercices a pointilles : exos, exostrois
%    - la macro \compensation pour les schemas de calcul en 2 etapes
%    - la macro \distrib pour le schema flechee de la distributivite
%    - la macro \mc pour colorer une table de multiplication par difficulte
%    - la macro \prog pour l'etiquette de niveau de programme
%
%  POUR MODIFIER LE RENDU D'UN ENCADRE dans tous les documents a la fois,
%  c'est ici et nulle part ailleurs.
% =====================================================================
\ProvidesPackage{stylecours}[2026/09/06 Style commun des cours de maths]

\RequirePackage{needspace}   % evite les titres orphelins en bas de page
\usetikzlibrary{arrows.meta, positioning, calc}
\tcbuselibrary{theorems, skins, hooks, breakable}

% Pas de cadre rouge autour des liens du sommaire
\hypersetup{hidelinks}

% Exposants a la francaise (1re, 4e, ...) : non fourni par babel english
\providecommand{\up}[1]{\textsuperscript{#1}}

% Sommaire en francais
\AtBeginDocument{\renewcommand{\contentsname}{Sommaire}}

% ---------------------------------------------------------------------
% Espacements : on ecrit de VRAIES lignes vides dans le source, jamais de
% \vspace a la main. C'est \parskip qui donne l'air entre deux paragraphes.
%
% \parindent vaut 0 (fixe dans macros.sty) : sans \parskip, deux paragraphes
% consecutifs seraient collés et indiscernables.
%
% Les display skips (l'air autour d'un \[ ... \] ou d'un align) sont reduits :
% par defaut LaTeX en met beaucoup trop pour un cours ou les calculs suivent
% immediatement la phrase qui les annonce.
% ---------------------------------------------------------------------
\AtBeginDocument{%
  \setlength{\parskip}{5pt plus 1.5pt minus 1pt}%
  \setlength{\abovedisplayskip}{4pt plus 1.5pt minus 1.5pt}%
  \setlength{\belowdisplayskip}{5pt plus 2pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{2pt plus 2pt}%
  \setlength{\belowdisplayshortskip}{5pt plus 2pt minus 2pt}%
}

% ---------------------------------------------------------------------
