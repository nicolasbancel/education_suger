% ---------------------------------------------------------------------
\definecolor{cmbleu}{HTML}{1F4E79}      % titres de partie
\definecolor{cmmagenta}{HTML}{A64D79}   % titres de section
\definecolor{thbg}{HTML}{E8F4F8}        % fond Theorie
\definecolor{thfr}{HTML}{2E75B6}        % bordure Theorie
\definecolor{asbg}{HTML}{D9EAD3}        % fond Astuce
\definecolor{asfr}{HTML}{38761D}        % bordure Astuce
\definecolor{atbg}{HTML}{FFE5E5}        % fond Attention
\definecolor{atfr}{HTML}{CC0000}        % bordure Attention
\definecolor{rebg}{HTML}{FFF2CC}        % fond A retenir
\definecolor{refr}{HTML}{E69138}        % bordure A retenir
\definecolor{exbleu}{HTML}{1C4587}      % barre des exemples
\definecolor{exorange}{HTML}{B45F06}    % barre des exercices
\definecolor{entete}{HTML}{C9DAF8}      % entete de tableau
\definecolor{exfond}{HTML}{F2F6FC}      % fond des exemples
